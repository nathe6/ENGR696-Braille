/*ARDUINO_IDE Version:
This is development code for the ARKS 696 Refreshable display demo piece.
*/
void setup() {
  Serial.begin(115200);
  pinMode(3, OUTPUT);
  pinMode(LED_BUILTIN, OUTPUT); // many ESP32-S3 boards define this
}

void loop() {
  digitalWrite(3, HIGH);
  digitalWrite(LED_BUILTIN, HIGH);
  Serial.println("high");
  delay(100);

  digitalWrite(3, LOW);
  digitalWrite(LED_BUILTIN, LOW);
  Serial.println("low");
  delay(100);
}
