@startuml braille
' skinparam linetype polyline

together {
    class board {
        # physical component
        + cell : cell obj
        + buttons : button obj
    }

    class cell {
        # phyiscal component
        + pin : pin obj
    }

        cell --|> board
        button --|> board
        pin --|> cell

    class pin {
        # physical component
        # CPP obj
        + info : int
        + asciiChar : string
        + void togglePin(char letter)
        + void asciiCharConvert(char letter)
    }

        pin <|-- BrailleTables : info from
        BrailleTables : char [][6] letterList
        BrailleTables : char [][6] numberList
        BrailleTables : string [] wordList

    class button {
        # physical component
        # CPP object
        - Define button inputs, set push/pull
        - includes braille tables
        + void debounce(float sec) 
        + void next(List *usedList) 
        + void previous(List *usedList)
        + void mode(List *usedList)
    }

        button <--> pin : passes info 
        button --> mode : changes val

}

class ESP32 {
    # physical component
    - MCP23017
    - I2C
    - board : board obj
    - ATTINY Interface
    + void init()
}

class ATTINY16x4 {
    # physical component
    + void init()
    + interruptHandler()
}

    ATTINY16x4 --|> ESP32
    board --|> ESP32

class SD {
    # physical component
    + data : char
    + void init()
    + void playAudio(string audioID)
    + void readFile(string *path)
    + void writeFile(string *path,string *data)
}

    SD <|-- audioList 
    audioList : string [] audioTrack
    mode -> SD : tells SD to play
    ESP32 <--> SD 

class led {
    # physical component
    # CPP object
    - define color values
    + void light(color val)
}

    led <-- mode : mode lights color

enum mode {
    + Letter
    + Number
    + Word
} 

@enduml