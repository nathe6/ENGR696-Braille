@startuml braille
skinparam linetype polyline

class board {
    cell : int
    buttons : int
}

    cell --|> board
    cell : Pin (object)
    button --|> board
    pin --|> cell

class pin {
    info : int
    asciiChar : string
    void togglePin()
    void asciiCharConvert()
}

    pin <|-- BrailleTables : info from
    BrailleTables : char [][6] letterList
    BrailleTables : char [][6] numberList
    BrailleTables : string [] wordList

class button {
    debounce : float 
    void next() 
    void previous()
    void mode()
}

    button --> pin : passes info
    button::mode --> mode : changes val

class GPIOExtender {
    
}

    GPIOExtender <-- pin : connected to

class 

class sd {
    void playAudio()
}

    sd <|-- audioList 
    audioList : string [] audioTrack
    mode --> sd : tells sd to play
    pin::togglePin ---> sd : tells sd to play after toggle

class led {
    void light()
}

    led <-- mode : mode lights color

enum mode {
    Letter
    Number
    Word
} 

@enduml