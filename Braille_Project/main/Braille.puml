@startuml braille
skinparam linetype polyline

class board {
    cell : int
    buttons : int
}

    cell --|> board
    cell : Pin (object)
    button --|> board
    pin --|> cell

class pin {
    info : int [6]
    asciiChar : string
    void togglePin()
    void asciiCharConvert()
}

    pin <-- BrailleTables : info goes to
    BrailleTables : char [][6] letterList
    BrailleTables : char [][6] numberList
    BrailleTables : string [] wordList

class button {
    debounce : float 
    void next() 
    void previous()
    void mode()
}

    button --> pin : passes info

class GPIOExtender {
    
}

    GPIOExtender <-- pin : connects pins

class sd {
    void playAudio()
}

    sd <|-- audioList 
    audioList : string [] audioTrack
    mode --> sd::playAudio : tells sd which audio to play
    pin --> sd::playAudio : tells sd which audio to play after toggle

class led {
    void light()
}

    led <-- mode : lights color based on mode

enum mode {
    Letter
    Number
    Word
} 

@enduml