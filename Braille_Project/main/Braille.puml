@startuml braille

class board {
    pins : int
    buttons : int
}

button --|> board
pin --|> board

class pin {
    info : int [6]
    asciiChar : string
    void togglePin()
    void asciiCharConvert()
}

    pin::info <-- BrailleTables : info goes to
    BrailleTables : char [][6] letterList
    BrailleTables : char [][6] numberList
    BrailleTables : string [] wordList
    pin::info --> pin::asciiChar : tells what char to be displayed

class button {
    debounce : float 
    void next() 
    void previous()
    void mode()
}

class GPIOExtender {

}

class sd {
    void playAudio()
}

    sd <|-- audioList 
    audioList : string [] audioTrack

class led {
    void light()
}

    led::light --> mode : uses

enum mode {
    Letter
    Number
    Word
} 

    button::next ---> pin::togglePin : calls, changes info & ascii val in pin
    button::previous ---> pin::togglePin : calls, changes info & ascii val in pin
    button::mode --> mode : has, mode() changes enum val

@enduml