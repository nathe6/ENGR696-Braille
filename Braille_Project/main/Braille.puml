@startuml braille
skinparam linetype polyline

class board {
    cell : int
    buttons : int
}

    cell --|> board
    cell : Pin (object)
    button --|> board
    pin --|> cell

class pin {
    info : int [6]
    asciiChar : string
    void togglePin()
    void asciiCharConvert()
}

    pin <-- BrailleTables : info goes to
    BrailleTables : char [][6] letterList
    BrailleTables : char [][6] numberList
    BrailleTables : string [] wordList
    pin --> pin::asciiChar : tells what char to be displayed

class button {
    debounce : float 
    void next() 
    void previous()
    void mode()
}

    button::next ---> pin : calls, changes info & ascii val in pin
    button::previous ---> pin : calls, changes info & ascii val in pin
    button::mode --> mode : has, mode() changes enum val

class GPIOExtender {
    
}

class sd {
    void playAudio()
}

    sd <|-- audioList 
    audioList : string [] audioTrack
    mode --> sd::playAudio : tells SD what audio to play
    pin --> sd::playAudio : pin toggles and tells sd what audio to play

class led {
    void light()
}

    led::light <-- mode : tells LED function what to light

enum mode {
    Letter
    Number
    Word
} 

@enduml